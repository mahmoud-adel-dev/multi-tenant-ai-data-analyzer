{
  "name": "aidlplatform",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "predev": "npm run db:migrate:indexes",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e:login": "node --env-file-if-exists=.env.local scripts/e2e-login.mjs",
    "build:worker": "esbuild scripts/worker.ts --bundle --platform=node --format=esm --outfile=dist-worker/index.mjs --external:mongoose --external:@aws-sdk/client-s3 --external:bcryptjs --banner:js=\"import { createRequire } from 'module'; const require = createRequire(import.meta.url);\"",
    "preworker": "npm run db:migrate:indexes",
    "worker": "node --env-file-if-exists=.env.local dist-worker/index.mjs",
    "worker:dev": "npm run build:worker && npm run worker",
    "db:migrate:indexes": "node --env-file-if-exists=.env.local scripts/migrate-indexes.mjs",
    "db:cleanup:analysis": "node --env-file-if-exists=.env.local scripts/cleanup-analysis-data.mjs",
    "dev:all": "npm run build:worker && npm run db:migrate:indexes && pm2 startOrRestart ecosystem.config.cjs --env development && node scripts/wait-for-services.mjs",
    "dev:all:restart": "npm run dev:all",
    "dev:all:status": "pm2 list",
    "dev:all:logs": "pm2 logs --namespace aidl-dev --lines 100",
    "dev:all:stop": "pm2 delete aidl-web aidl-worker aidl-analytics"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.879.0",
    "bcryptjs": "^2.4.3",
    "clsx": "^2.1.1",
    "echarts": "^6.0.0",
    "ioredis": "^5.8.2",
    "lucide-react": "^0.408.0",
    "mongoose": "^8.5.1",
    "next": "^15.5.23",
    "next-auth": "^4.24.14",
    "next-themes": "^0.4.6",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-hot-toast": "^2.6.0",
    "tailwind-merge": "^2.4.0",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@aws-sdk/s3-request-presigner": "^3.1116.0",
    "@tailwindcss/postcss": "^4.0.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "esbuild": "^0.28.2",
    "eslint": "^9",
    "eslint-config-next": "^15.5.23",
    "pm2": "^7.0.3",
    "tailwindcss": "^4.0.0",
    "typescript": "5.8.2",
    "vitest": "^4.1.11"
  }
}
