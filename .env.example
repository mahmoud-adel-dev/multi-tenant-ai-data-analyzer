# Core
MONGODB_URI=mongodb://localhost:27017/aidl-platform
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3001

# Generate with: openssl rand -hex 32
APP_ENCRYPTION_KEY=

# Object storage: local | s3
STORAGE_DRIVER=local
STORAGE_LOCAL_PATH=./storage-data
S3_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false

# Analytics service
ANALYTICS_SERVICE_URL=http://localhost:8000
ANALYTICS_API_TOKEN=
ANALYTICS_TIMEOUT_MS=600000
ANALYTICS_MAX_UPLOAD_BYTES=262144000
ANALYTICS_MAX_ROWS=5000000
ANALYTICS_MAX_COLUMNS=500
ANALYTICS_MAX_EXCEL_MB=100

# Reliability and observability
REDIS_URL=
LOG_LEVEL=info
ALLOWED_ORIGINS=
MAX_UPLOAD_MB_DEFAULT=100
SENTRY_DSN=
